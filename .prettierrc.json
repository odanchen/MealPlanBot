{
  "plugins": ["prettier-plugin-java", "prettier-plugin-sh"],
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "overrides": [
    {
      "files": "*.java",
      "options": { "tabWidth": 4 }
    }
  ]
}
