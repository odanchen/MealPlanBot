{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9]*(?:-[a-zA-Z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "servings": {
      "type": "object",
      "properties": {
        "estimate": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["estimate", "note"],
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "properties": {
        "prepMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "cookMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "guidance": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1
    },
    "preparationGuidance": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "alt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["path", "alt"],
        "additionalProperties": false
      }
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ingredientId": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*(?:-[a-zA-Z0-9]+)*$"
          },
          "quantity": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)(?:[.][0-9]+)?$"
          },
          "unit": {
            "enum": [
              "g",
              "kg",
              "oz",
              "lb",
              "ml",
              "l",
              "us-cup",
              "us-tbsp",
              "us-tsp",
              "us-fl-oz",
              "count",
              "clove",
              "bunch",
              "tin-156ml"
            ]
          },
          "optional": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        },
        "required": ["ingredientId", "quantity", "unit"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*(?:-[a-zA-Z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9]*(?:-[a-zA-Z0-9]+)*$"
                },
                "content": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string"
                          }
                        },
                        "required": ["text"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "term": {
                            "type": "string",
                            "pattern": "^[a-zA-Z][a-zA-Z0-9]*(?:-[a-zA-Z0-9]+)*$"
                          },
                          "label": {
                            "type": "string",
                            "minLength": 1
                          },
                          "explanation": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": ["term"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string",
                            "minLength": 1
                          },
                          "explanation": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": ["label", "explanation"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "recipe": {
                            "type": "string",
                            "pattern": "^[a-zA-Z][a-zA-Z0-9]*(?:-[a-zA-Z0-9]+)*$"
                          },
                          "label": {
                            "type": "string",
                            "minLength": 1
                          },
                          "section": {
                            "type": "string",
                            "pattern": "^[a-zA-Z][a-zA-Z0-9]*(?:-[a-zA-Z0-9]+)*$"
                          }
                        },
                        "required": ["recipe"],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "minItems": 1
                }
              },
              "required": ["id", "content"],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": ["id", "title", "steps"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "servings",
    "timing",
    "preparationGuidance",
    "ingredients",
    "sections"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
