root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{java,kts}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Preserve upstream wrapper bytes and checksum-protected migrations.
[{backend/gradlew,backend/gradlew.bat,backend/src/main/resources/db/migrations/*.sql}]
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
