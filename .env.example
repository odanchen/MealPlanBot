# Future Pi/production runtime environment; not needed for scripts/run-local.sh.
# Supply through the process environment or the eventual systemd EnvironmentFile.
# Spring Boot does not automatically load this file or .env.
DEPLOYMENT_TARGET=pi
DATABASE_PATH=/var/lib/mealplan/app.sqlite
PUBLIC_BASE_URL=https://mealplan.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
