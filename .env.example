# Pi runtime: /etc/mealplan/mealplan.env, root-owned mode 0600, outside Git.
# Spring Boot does not automatically load a repository .env file.
DEPLOYMENT_TARGET=pi
DATABASE_PATH=/var/lib/mealplan/app.sqlite
PUBLIC_BASE_URL=https://mealplan.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# MEALPLAN_COMMIT is written separately to /var/lib/mealplan/runtime.env by deployment.
# GitHub artifact credentials (GH_TOKEN/gh auth) belong to the deploy operator,
# never to this application environment file.
